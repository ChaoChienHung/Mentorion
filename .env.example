# Copy this file to `.env.local` (gitignored) for local configuration.

# Private Data Vault override (unifies app.db, questions.json, and library/)
# Default when unset: ./data
# Example pointing to a sibling private repo:
MENTORION_VAULT_DIR=../Mentorion-Vault

# Multi-LLM Provider Configuration (auto selects: gemini -> openai -> anthropic)
LLM_PROVIDER=auto
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
